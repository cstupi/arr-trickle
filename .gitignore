# --- Secrets: never commit these ---------------------------------------------
# arr-trickle reads API keys from the *arr apps at run time; nothing secret belongs in git.
.env
.env.*
*.env
secrets/
*.key
*.pem
*.p12
*.pfx
# an *arr app's config.xml contains its API key
config.xml
# your real settings and state (examples/config.toml is the committed template)
config.toml
config.toml.bak
!examples/config.toml
budget.json
heartbeat
paused
activity.jsonl*
# web UI state: the admin's password hash and the one-time setup code
auth.json
setup-code
*.tmp

# --- Go -------------------------------------------------------------------
/arr-trickle
*.test
*.out
cover.html
vendor/

# --- Editors / OS ----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
@eaDir/
